Cell[BoxData[
 RowBox[{
  RowBox[{"iterateFaces", "[", "vStart_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", " ", "=", " ", "vStart"}], ",", " ", 
      RowBox[{"steps", " ", "=", " ", 
       RowBox[{"{", "vStart", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", " ", "=", " ", 
         RowBox[{"faceStep", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"v", " ", "!=", " ", "vStart"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"steps", ",", " ", "v"}], "]"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "steps"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9995108595842075`*^9, 3.9995109293079224`*^9}, {
