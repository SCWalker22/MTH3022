Cell[BoxData[
 RowBox[{
  RowBox[{"fillFaces", "[", "halfEdges_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"remaining", " ", "=", " ", "halfEdges"}], ",", " ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"remaining", " ", "=!=", " ", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"v", " ", "=", " ", 
         RowBox[{"First", "[", "remaining", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"faces", " ", "=", " ", 
         RowBox[{"iterateFaces", "[", "v", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"result", ",", " ", "faces"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"remaining", " ", "=", " ", 
         RowBox[{"Complement", "[", 
          RowBox[{"remaining", ",", " ", "faces"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "result"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.99951127773291*^9, 3.9995114538807316`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"088ccb28-4409-a44f-a962-de19f3ae2507"],

