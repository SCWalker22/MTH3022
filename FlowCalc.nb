Cell["\<\
Recursively label - check if the tail is in X, and not at capacity, then add \
the head, or if the head is in X, and flow is not 0, add the tail\
\>", "Text",
 CellChangeTimes->{{3.999675750336396*^9, 3.999675753985722*^9}, {
  3.999675830948351*^9, 
  3.9996758584561*^9}},ExpressionUUID->"9c202834-23a3-4db2-9554-c1841f68eb38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xStep", "[", "X_", "]"}], " ", ":=", "\[IndentingNewLine]", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteDuplicates", "@", "\[IndentingNewLine]", 
    RowBox[{"Join", "[", 
     RowBox[{"X", ",", "\[IndentingNewLine]", 
      RowBox[{"head", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"edges", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"X", ",", " ", 
             RowBox[{"tail", "[", "#", "]"}]}], "]"}], " ", "&&", 
           "\[IndentingNewLine]", 
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"saturated", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"tail", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"edges", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"X", ",", " ", 
             RowBox[{"head", "[", "#", "]"}]}], "]"}], " ", "&&", 
           "\[IndentingNewLine]", 
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
